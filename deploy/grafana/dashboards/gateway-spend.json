{
  "uid": "gateway-spend",
  "title": "LLM Gateway \u2014 Spend",
  "tags": [
    "llm-gateway"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 16,
      "title": "Yesterday (UTC): who spent how much, on which model",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT tenant_id AS tenant, coalesce(model, '(failed)') AS model, count(*) AS requests,\n       sum(prompt_tokens) AS prompt_tokens, sum(completion_tokens) AS completion_tokens,\n       round(sum(cost_usd)::numeric, 6) AS cost_usd, round(sum(saved_usd)::numeric, 6) AS saved_by_cache_usd\nFROM request_logs WHERE ts >= date_trunc('day', now() AT TIME ZONE 'utc') - interval '1 day' AND ts < date_trunc('day', now() AT TIME ZONE 'utc')\nGROUP BY 1, 2 ORDER BY cost_usd DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "title": "Spend per tenant (selected range)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT $__timeGroupAlias(ts, $__interval), tenant_id AS metric, sum(cost_usd)::float AS value\nFROM request_logs WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "title": "Spend per model (selected range)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT $__timeGroupAlias(ts, $__interval), coalesce(model, '(failed)') AS metric, sum(cost_usd)::float AS value\nFROM request_logs WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "title": "Spend by tenant and model (selected range)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT tenant_id AS tenant, coalesce(model, '(failed)') AS model, count(*) AS requests, round(sum(cost_usd)::numeric, 6) AS cost_usd,\n       round(sum(saved_usd)::numeric, 6) AS saved_usd,\n       round(100.0 * count(*) FILTER (WHERE cache_status LIKE 'hit%') / count(*), 1) AS cache_hit_pct\nFROM request_logs WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY cost_usd DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "title": "Most expensive requests (selected range)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT ts, request_id, tenant_id, alias, provider, model, prompt_tokens, completion_tokens, cost_usd::float, latency_ms\nFROM request_logs WHERE $__timeFilter(ts) ORDER BY cost_usd DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 21,
      "title": "Requests that needed a failover (selected range)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nSELECT ts, request_id, alias, coalesce(provider, '(failed)') AS served_by, jsonb_array_length(attempts) AS attempts,\n       attempts::text AS attempt_log\nFROM request_logs WHERE $__timeFilter(ts) AND jsonb_array_length(attempts) > 1 ORDER BY ts DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "gridPos": {
