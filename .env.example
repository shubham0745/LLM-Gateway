# Copy to .env. Leave a provider key empty to skip that provider in fallback chains.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GATEWAY_ADMIN_TOKEN=change-me-admin-token
GATEWAY_KEY_PEPPER=change-me-pepper

# Production only (deploy/docker-compose.prod.yml)
DOMAIN=
GRAFANA_ADMIN_PASSWORD=
# Worker processes for the gateway (empty = one per CPU, at most 4)
GATEWAY_WORKERS=
